<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StraumurTapToPaySample.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local, gitignored credentials — copied to the output so `dotnet run` picks them up. -->
    <Content Include="secrets.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('secrets.json')" />
  </ItemGroup>

</Project>
