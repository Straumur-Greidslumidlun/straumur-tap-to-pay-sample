# ---- .NET (server/) ----
bin/
obj/
*.user
.vs/

# Secrets — never commit API keys. Real values go in secrets.json (the .example is kept).
secrets.json
appsettings.*.local.json
*.secrets.json

# ---- Node / Expo (app/) ----
node_modules/
.expo/
dist/
web-build/
*.log

# Adyen SDK-download key (per-developer, local) — never commit. The .example template is kept.
adyen-sdk.properties

# Expo prebuild output for the RN app (regenerated by `expo prebuild`). Scoped to that app's
# root so the native Android sample and the RN module's own android/ source stay tracked.
/app/react-native/android/
/app/react-native/ios/

# Gradle output (native Android sample + the RN app's local module) — source stays tracked.
build/
.gradle/
local.properties
.cxx/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
