# ---- .NET (server/) ----
bin/
obj/
*.user
.vs/

# Secrets — never commit API keys. Use env vars or user-secrets (see server/README.md).
appsettings.*.local.json
*.secrets.json

# ---- Node / Expo (app/) ----
node_modules/
.expo/
dist/
web-build/
*.log

# Adyen SDK-download key (per-developer, local) — never commit. The .example template is kept.
adyen-sdk.properties

# Expo prebuild output (regenerated by `expo prebuild`) — app root only, so the native
# module's own android/ source stays tracked.
/app/android/
/app/ios/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
