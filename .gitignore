# ---- .NET (server/) ----
bin/
obj/
*.user
.vs/

# Secrets — never commit API keys. Real values go in secrets.json (the .example is kept).
secrets.json
appsettings.*.local.json
*.secrets.json

# ---- Node / Expo (app/) ----
node_modules/
.expo/
dist/
web-build/
*.log

# Adyen SDK-download key (per-developer, local) — never commit. The .example template is kept.
adyen-sdk.properties

# Expo prebuild output (regenerated by `expo prebuild`) — app root only, so the native
# module's own android/ source stays tracked.
/app/android/
/app/ios/

# Gradle output inside the local native module (its source stays tracked).
/app/modules/**/build/
/app/modules/**/.gradle/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
